<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older auto backup. The device id must be new on a restored phone; custom cover images could pass the 25 MB backup quota (rows restore, the automatic cover shows until the user picks again). Plugin packages are left out: the database restores the installed list and each package installs again from its source; plugin logs are not worth backing up. -->
<full-backup-content>
    <exclude domain="file" path="data/device_id"/>
    <exclude domain="file" path="data/custom_covers"/>
    <exclude domain="file" path="data/plugins"/>
    <exclude domain="file" path="data/plugin-logs"/>
</full-backup-content>
