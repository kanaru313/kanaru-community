<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup and device transfer. The device id must be new on a restored phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="data/device_id"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="data/device_id"/>
    </device-transfer>
</data-extraction-rules>
