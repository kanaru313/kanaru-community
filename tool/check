#!/usr/bin/env bash
# Full local gate. Run from anywhere inside the nix shell:
#   tool/check            Dart checks
#   tool/check --rust     plus tool/check_rust (fmt, unsafe grep, audit, test, clippy)
set -euo pipefail
cd "$(dirname "$0")/.."

dart run tool/merge_arb.dart --check
flutter gen-l10n
flutter analyze
dart analyze
dart run tool/check_architecture.dart
flutter test
(cd packages/kanaru_ui && flutter test)
(cd tool/architecture_lint && dart test)

if [[ "${1:-}" == "--rust" ]]; then
  tool/check_rust
fi
